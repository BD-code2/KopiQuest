<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF9EE"
    tools:context=".HasilActivity">

    <!-- JUDUL -->
    <TextView
        android:id="@+id/tvJudulHasil"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="70dp"
        android:text="PERMAINAN SELESAI!"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#3B250F"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ICON KOPI -->
    <TextView
        android:id="@+id/tvIconKopi"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:text="☕"
        android:textSize="65sp"

        app:layout_constraintTop_toBottomOf="@id/tvJudulHasil"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- TEKS SKOR -->
    <TextView
        android:id="@+id/tvLabelSkor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="SKOR KAMU"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#3B250F"

        app:layout_constraintTop_toBottomOf="@id/tvIconKopi"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- SKOR -->
    <TextView
        android:id="@+id/tvSkorAkhir"
        android:layout_width="220dp"
        android:layout_height="90dp"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="80 / 100"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="#3B250F"
        android:background="@drawable/bg_skor"

        app:layout_constraintTop_toBottomOf="@id/tvLabelSkor"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- PESAN -->
    <TextView
        android:id="@+id/tvPesan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:text="Mantap! Kamu jago mengenali logo kopi!"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#3B250F"

        app:layout_constraintTop_toBottomOf="@id/tvSkorAkhir"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- MAIN LAGI -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnMainLagi"
        android:layout_width="280dp"
        android:layout_height="60dp"
        android:layout_marginTop="30dp"
        android:text="🔄  MAIN LAGI"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#3B250F"
        android:elevation="5dp"

        app:backgroundTint="#FFC928"
        app:cornerRadius="18dp"

        app:layout_constraintTop_toBottomOf="@id/tvPesan"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- MENU UTAMA -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnMenuUtama"
        android:layout_width="280dp"
        android:layout_height="60dp"
        android:layout_marginTop="15dp"
        android:text="🏠  MENU UTAMA"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#3B250F"
        android:elevation="5dp"

        app:backgroundTint="#FFC928"
        app:cornerRadius="18dp"

        app:layout_constraintTop_toBottomOf="@id/btnMainLagi"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- WAVE COKELAT -->
    <View
        android:id="@+id/waveBawah"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:background="@drawable/wave_bawah"

        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>